# Application Settings
APP_NAME="IncuBrix B-Roll Video Engine"
APP_ENV="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# API Keys for Stock Media Providers
PEXELS_API_KEY="your_pexels_api_key_here"
PIXABAY_API_KEY="58141564-73e1b03fa6a1ca79b4d5047e8"

# Storage & Database
DATABASE_URL="sqlite:///./jobs/broll_engine.db"
JOBS_DIR="./jobs"
ASSETS_DIR="./assets"
FALLBACK_CLIP_PATH="./assets/fallback_broll.mp4"

# Processing Constraints & Timeouts
WHISPER_MODEL_SIZE="base"
MAX_AUDIO_DURATION_SECONDS=600.0
MAX_UPLOAD_SIZE_MB=50
API_TIMEOUT_SECONDS=15.0
FFMPEG_TIMEOUT_SECONDS=300
JOB_TIMEOUT_SECONDS=600
PAUSE_THRESHOLD_SECONDS=0.8
TARGET_WIDTH=1280
TARGET_HEIGHT=720
TARGET_FPS=30
